{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-07-17",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "subsequent-ring",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"kv_namespaces": [
		{
			// Step 1 — create the namespace:
			//   npx wrangler kv namespace create LEADERBOARD
			// Step 2 — create a preview namespace (used by `wrangler dev`):
			//   npx wrangler kv namespace create LEADERBOARD --preview
			// Step 3 — paste the IDs returned by those commands below.
			"binding": "LEADERBOARD",
			"id": "09e962f256dc44898149aedeffd94488",
			"preview_id": "8a5f01afba324aba8711c3aec532d0f4"
		},
		{
			"binding": "SESSION",
			"id": "bde8aa0701d6463d97b861c8f33f3c74"
		}
	],
	"observability": {
		"enabled": true
	}
}