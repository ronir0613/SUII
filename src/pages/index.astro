---
import Layout from "../layouts/Layout.astro";
import SuiSpawner from "../components/SuiSpawner";
---

<Layout>
  <SuiSpawner client:load />
  <div id="color-container"></div>
</Layout>

<style>
  #color-container {
    width: 100vw;
    height: 100dvh;
    display: flex;
    justify-content: center;
    align-items: center;
    transition: background-color 1s ease-in-out;
    background-color: #ffbe91;
    cursor: pointer;
    position: relative;
    overflow: hidden;
  }
</style>

<script>
  const colors = [
    "#FFBE91",
    "#FFDDB0",
    "#FFFCE1",
    "#CFEBFF",
    "#FCF8F8",
    "#FBEFEF",
    "#F9DFDF",
  ];

  let currentIndex = 0;
  const container = document.getElementById("color-container");

  function changeColor() {
    currentIndex = (currentIndex + 1) % colors.length;
    if (container) {
      container.style.backgroundColor = colors[currentIndex];
    }
  }

  if (container) {
    container.addEventListener("click", () => {
      changeColor();
    });
  }
</script>
